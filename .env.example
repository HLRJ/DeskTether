# Windows: separate multiple roots with semicolons.
DESKTETHER_ALLOWED_ROOTS=G:\Codes

# Comma-separated command prefixes blocked before process spawn.
DESKTETHER_BLOCKED_COMMANDS=format,diskpart,shutdown,shutdown.exe,restart-computer

# Optional. Defaults to %USERPROFILE%\.desktether\audit.jsonl
# DESKTETHER_AUDIT_PATH=G:\Logs\desktether-audit.jsonl
