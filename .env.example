# Windows: separate multiple roots with semicolons.
DESKTETHER_ALLOWED_ROOTS=

# Legacy denylist. Still supported and mapped to DENY.
DESKTETHER_BLOCKED_COMMANDS=format,diskpart,shutdown,shutdown.exe,restart-computer

# Three-state command policy. Comma-separated command prefixes.
DESKTETHER_DENY_COMMANDS=
DESKTETHER_CONFIRM_COMMANDS=remove-item -recurse,git push,npm publish,pnpm publish
DESKTETHER_ALLOW_COMMANDS=git status,pnpm test

# Optional. Defaults to %USERPROFILE%\.desktether\audit.jsonl
# DESKTETHER_AUDIT_PATH=%USERPROFILE%\.desktether\audit.jsonl

# OpenAI Secure MCP Tunnel runtime prerequisites.
# Create these outside the repository; do not commit real values.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Optional override if tunnel-client is installed elsewhere.
# TUNNEL_CLIENT_BIN=
